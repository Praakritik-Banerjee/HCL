# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Personalized Learning Path Generator"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 15)
DATABASE_URL=postgresql://learner:learner@localhost:5432/learning_path

# Cache & State Management (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=syllabus_knowledge_base

# LLM Configuration
LLM_PROVIDER=openai # or "ollama"
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion Constraints
MAX_CHUNK_TOKENS=500
MIN_CHUNK_TOKENS=150
CHUNK_OVERLAP_TOKENS=50
